/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'sha256-VQmXyLfpV0uufI5WW4nEnMBC9MBD4YdVfq6iDkZYh58=' https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com https://*.cloudflareinsights.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

/assets/neo-missions/*
  Cache-Control: public, max-age=3600
  Content-Type: application/json; charset=utf-8
